# 1Fi LMS Backend - Environment Variables for Railway
# Copy these to your Railway service variables

# Database (Railway provides this automatically when you link PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT Secret (generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Port (Railway sets this automatically)
PORT=3001

# Frontend URL (for CORS - set to your deployed frontend URL)
FRONTEND_URL=https://your-frontend.railway.app

# Node Environment
NODE_ENV=production
